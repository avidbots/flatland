<?xml version="1.0"?>
<package format="3">
  <name>flatland_ros2_control_examples</name>
  <version>0.1.0</version>
  <description>Flatland wheeled vehicle models for topic-based ros2_control.</description>
  <maintainer email="joseph@avidbots.com">Joseph Duchesne</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>flatland_server</exec_depend>
  <exec_depend>flatland_plugins</exec_depend>
    <depend>flatland_controls_plugins</depend>
  <exec_depend>flatland_viz</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_command_topic_hardware_interface</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>ackermann_steering_controller</exec_depend>
  <exec_depend>tricycle_controller</exec_depend>
  <exec_depend>forward_command_controller</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>teleop_twist_joy</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>interactive_markers</test_depend>
  <test_depend>rclcpp</test_depend>

  <export><build_type>ament_cmake</build_type></export>
</package>